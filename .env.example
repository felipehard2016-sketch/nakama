# ══════════════════════════════════════════════════════════
# NAKAMA — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA compartilhe o .env ou comite-o no Git.
# ══════════════════════════════════════════════════════════

# Supabase — encontre em: https://supabase.com → seu projeto → Settings → API
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_SUA_CHAVE_ANON_PUBLICA

# RAWG (catálogo de jogos, passo 7) — opcional, ainda não usado no código.
# Sem essa chave, a página /jogos funciona em modo de cadastro manual.
# Gere uma grátis em https://rawg.io/apidocs
VITE_RAWG_API_KEY=
